{
  "name": "LRA Volume TeX",
  "build": {
    "dockerfile": "__LRA_TEX_DOCKERFILE__",
    "context": "__LRA_TEX_CONTEXT__"
  },
  "remoteEnv": {
    "LRA_GOVERNANCE_ROOT": "/lra-governance",
    "LRA_COMMON_ROOT": "/lra-common",
    "LRA_EDITION": "digital",
    "LRA_PAPER": "letter"
  },
  "containerEnv": {
    "LRA_GOVERNANCE_ROOT": "/lra-governance",
    "LRA_COMMON_ROOT": "/lra-common",
    "LRA_EDITION": "digital",
    "LRA_PAPER": "letter"
  },
  "mounts": [
    "source=__LRA_GOVERNANCE_ROOT__,target=/lra-governance,type=bind,readonly",
    "source=__LRA_COMMON_ROOT__,target=/lra-common,type=bind,readonly",
    "source=__LRA_COMMON_ROOT__/common,target=${containerWorkspaceFolder}/common,type=bind,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "James-Yu.latex-workshop"
      ],
      "settings": {
        "latex-workshop.latex.autoBuild.run": "never",
        "latex-workshop.latex.build.enableMagicComments": true,
        "latex-workshop.latex.outDir": "build",
        "latex-workshop.latex.recipe.default": "latexmk (lualatex)",
        "latex-workshop.latex.tools": [
          {
            "name": "latexmk-lualatex",
            "command": "latexmk",
            "args": [
              "-lualatex",
              "-interaction=nonstopmode",
              "-file-line-error",
              "-synctex=1",
              "-shell-escape",
              "%DOC%"
            ]
          }
        ],
        "latex-workshop.latex.recipes": [
          {
            "name": "latexmk (lualatex)",
            "tools": [
              "latexmk-lualatex"
            ]
          }
        ],
        "latex-workshop.view.pdf.viewer": "tab",
        "latex-workshop.synctex.afterBuild.enabled": true
      }
    }
  }
}
