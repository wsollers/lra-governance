{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wsollers/lra-governance/constitution/schema/concept-authoring-package.schema.json",
  "title": "LRA Source-Grounded Concept Authoring Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "record_format",
    "authority",
    "concept_contracts",
    "evidence",
    "candidates",
    "review_events",
    "generation_package",
    "generation_receipts"
  ],
  "properties": {
    "schema_version": {"const": "lra.source-grounded-concept-package/0.2"},
    "package_id": {"$ref": "#/$defs/stable_id"},
    "record_format": {"enum": ["json", "yaml"]},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_owner",
        "concept_contract_owner",
        "vocabulary_authority",
        "evidence_owner",
        "review_owner",
        "generation_owner"
      ],
      "properties": {
        "schema_owner": {"const": "wsollers/lra-governance"},
        "concept_contract_owner": {"type": "string", "minLength": 1},
        "vocabulary_authority": {"type": "string", "minLength": 1},
        "evidence_owner": {"type": "string", "minLength": 1},
        "review_owner": {"type": "string", "minLength": 1},
        "generation_owner": {"type": "string", "minLength": 1}
      }
    },
    "concept_contracts": {
      "type": "array",
      "items": {"$ref": "#/$defs/concept_contract"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_record"}
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "review_events": {
      "type": "array",
      "items": {"$ref": "#/$defs/review_event"}
    },
    "generation_package": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "generation_package_id",
        "tool_versions",
        "approved_candidate_revisions",
        "ordering"
      ],
      "properties": {
        "generation_package_id": {"$ref": "#/$defs/stable_id"},
        "tool_versions": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "approved_candidate_revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "revision_id"],
            "properties": {
              "candidate_id": {"$ref": "#/$defs/stable_id"},
              "revision_id": {"$ref": "#/$defs/stable_id"}
            }
          }
        },
        "ordering": {"const": "stable-id-lexicographic"}
      }
    },
    "generation_receipts": {
      "type": "array",
      "items": {"$ref": "#/$defs/generation_receipt"}
    }
  },
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "reviewed_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value"],
      "properties": {
        "state": {"enum": ["absent", "not_applicable", "unresolved", "proposed", "approved"]},
        "value": {},
        "notes": {"type": ["string", "null"]}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "concept_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_id",
        "display_name",
        "normalized_definition",
        "carrier_and_ambient_structures",
        "notation_and_variable_roles",
        "intended_lean_signature",
        "learner_facing_terminology",
        "accepted_synonyms",
        "excluded_meanings",
        "primary_concept_owner",
        "related_concepts",
        "target",
        "contract_revision",
        "contract_status",
        "reviewer_attribution"
      ],
      "properties": {
        "concept_id": {"$ref": "#/$defs/stable_id"},
        "display_name": {"$ref": "#/$defs/reviewed_value"},
        "normalized_definition": {"$ref": "#/$defs/reviewed_value"},
        "carrier_and_ambient_structures": {"$ref": "#/$defs/reviewed_value"},
        "notation_and_variable_roles": {"$ref": "#/$defs/reviewed_value"},
        "intended_lean_signature": {"$ref": "#/$defs/reviewed_value"},
        "learner_facing_terminology": {"$ref": "#/$defs/reviewed_value"},
        "accepted_synonyms": {"$ref": "#/$defs/reviewed_value"},
        "excluded_meanings": {"$ref": "#/$defs/reviewed_value"},
        "primary_concept_owner": {"$ref": "#/$defs/reviewed_value"},
        "related_concepts": {"$ref": "#/$defs/reviewed_value"},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["volume", "topic", "concept_folder"],
          "properties": {
            "volume": {"$ref": "#/$defs/reviewed_value"},
            "topic": {"$ref": "#/$defs/reviewed_value"},
            "concept_folder": {"$ref": "#/$defs/reviewed_value"}
          }
        },
        "contract_revision": {"$ref": "#/$defs/stable_id"},
        "contract_status": {"enum": ["draft", "proposed", "approved", "retired"]},
        "reviewer_attribution": {
          "type": "array",
          "items": {"$ref": "#/$defs/reviewer"}
        }
      }
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "lane",
        "supports_candidate_ids",
        "unresolved_ambiguity",
        "supersedes"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/stable_id"},
        "lane": {
          "enum": [
            "primary_source",
            "external_mathlib",
            "internal_lra_integration",
            "independent_pedagogy",
            "mechanical_derivation"
          ]
        },
        "source_id": {"type": ["string", "null"]},
        "source_profile": {"type": ["string", "null"]},
        "source_snapshot": {"type": ["string", "null"]},
        "mathlib_commit": {"type": ["string", "null"]},
        "mathlib_module": {"type": ["string", "null"]},
        "mathlib_declaration": {"type": ["string", "null"]},
        "exact_signature": {"type": ["string", "null"]},
        "locator": {"type": ["string", "null"]},
        "extraction_quality": {"enum": ["not_applicable", "indexed_text", "direct_pdf", "ocr_reviewed", "ambiguous"]},
        "raw_excerpt_or_locator": {"type": ["string", "null"]},
        "normalization_notes": {"type": ["string", "null"]},
        "supports_candidate_ids": {"type": "array", "items": {"$ref": "#/$defs/stable_id"}},
        "relationship_to_candidate": {"type": ["string", "null"]},
        "unresolved_ambiguity": {"type": ["string", "null"]},
        "supersedes": {"type": ["string", "null"]}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "concept_id",
        "contract_revision",
        "current_revision_id",
        "primary_concept_owner",
        "related_concepts",
        "revisions"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/stable_id"},
        "concept_id": {"$ref": "#/$defs/stable_id"},
        "contract_revision": {"$ref": "#/$defs/stable_id"},
        "current_revision_id": {"$ref": "#/$defs/stable_id"},
        "primary_concept_owner": {"type": "string", "minLength": 1},
        "related_concepts": {"type": "array", "items": {"$ref": "#/$defs/stable_id"}},
        "revisions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/normalized_revision"}
        }
      }
    },
    "normalized_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "normalized_statement",
        "artifact_kind",
        "proposed_lean_name",
        "carrier_structure",
        "hypotheses",
        "evidence_refs",
        "provenance_categories",
        "normalization_performed",
        "meaning_change_from_previous",
        "mathematical_interest",
        "learner_value",
        "proposed_placement",
        "proof_expectation",
        "recommendation",
        "unresolved_fields"
      ],
      "properties": {
        "revision_id": {"$ref": "#/$defs/stable_id"},
        "normalized_statement": {"type": "string", "minLength": 1},
        "artifact_kind": {"enum": ["definition", "theorem", "lemma", "proposition", "corollary", "example", "counterexample", "exercise"]},
        "proposed_lean_name": {"type": ["string", "null"]},
        "carrier_structure": {"type": ["string", "null"]},
        "hypotheses": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/stable_id"}},
        "provenance_categories": {
          "type": "array",
          "items": {"enum": ["primary_source", "external_mathlib", "internal_lra_integration", "independent_pedagogy", "mechanical_derivation"]}
        },
        "normalization_performed": {"type": "array", "items": {"type": "string"}},
        "meaning_change_from_previous": {"type": "boolean"},
        "mathematical_interest": {"enum": ["unresolved", "low", "medium", "high"]},
        "learner_value": {"enum": ["unresolved", "low", "medium", "high"]},
        "proposed_placement": {"type": ["string", "null"]},
        "proof_expectation": {"enum": ["not_applicable", "routine", "requires_mathlib", "requires_new_proof", "unknown"]},
        "recommendation": {"enum": ["propose", "approve", "defer", "reject", "reassign"]},
        "unresolved_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "review_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "reviewer",
        "timestamp",
        "action",
        "rationale",
        "candidate_id",
        "affected_revision_id",
        "previous_state",
        "resulting_state"
      ],
      "properties": {
        "event_id": {"$ref": "#/$defs/stable_id"},
        "reviewer": {"$ref": "#/$defs/reviewer"},
        "timestamp": {"$ref": "#/$defs/timestamp"},
        "action": {"enum": ["discovered", "normalized", "proposed", "approved", "approve_with_edit", "deferred", "rejected", "reassigned", "moved_to_related_concept", "generated", "lean_validated", "publication_approved"]},
        "rationale": {"type": "string", "minLength": 1},
        "candidate_id": {"$ref": "#/$defs/stable_id"},
        "affected_revision_id": {"$ref": "#/$defs/stable_id"},
        "previous_state": {"enum": ["none", "discovered", "normalized", "proposed", "approved", "deferred", "rejected", "reassigned", "generated", "lean_validated", "publication_approved"]},
        "resulting_state": {"enum": ["discovered", "normalized", "proposed", "approved", "deferred", "rejected", "reassigned", "generated", "lean_validated", "publication_approved"]},
        "edited_revision_id": {"type": ["string", "null"]},
        "destination_concept_id": {"type": ["string", "null"]}
      }
    },
    "generation_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "generation_package_id", "tool_versions", "emitted_artifacts"],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/stable_id"},
        "generation_package_id": {"$ref": "#/$defs/stable_id"},
        "tool_versions": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "emitted_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "candidate_id", "revision_id"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "candidate_id": {"$ref": "#/$defs/stable_id"},
              "revision_id": {"$ref": "#/$defs/stable_id"}
            }
          }
        }
      }
    }
  }
}
