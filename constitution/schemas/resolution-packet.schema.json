{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lra.local/schemas/resolution-packet.schema.json",
  "title": "LRA governance resolution packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version",
    "manifest_version",
    "repo",
    "repo_kind",
    "task",
    "route",
    "match_type",
    "matched_trigger",
    "governance_root",
    "entrypoint",
    "token_estimator",
    "estimated_tokens",
    "token_budget",
    "headroom",
    "eager_instructions",
    "lazy_references",
    "tools",
    "schemas",
    "examples",
    "outputs",
    "verify",
    "warnings"
  ],
  "properties": {
    "packet_version": {"type": "integer", "minimum": 1},
    "manifest_version": {"type": "integer", "minimum": 1},
    "repo": {"type": "string", "minLength": 1},
    "repo_kind": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "route": {"type": "string", "minLength": 1},
    "match_type": {"enum": ["trigger", "default"]},
    "matched_trigger": {"type": ["string", "null"]},
    "governance_root": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "string", "minLength": 1},
    "token_estimator": {"const": "unicode_chars_div_4_ceil"},
    "estimated_tokens": {"type": "integer", "minimum": 0},
    "token_budget": {"type": "integer", "minimum": 1},
    "headroom": {"type": "integer"},
    "eager_instructions": {"$ref": "#/$defs/stringList"},
    "lazy_references": {"$ref": "#/$defs/stringList"},
    "tools": {"$ref": "#/$defs/stringList"},
    "schemas": {"$ref": "#/$defs/stringList"},
    "examples": {"$ref": "#/$defs/stringList"},
    "outputs": {"$ref": "#/$defs/stringList"},
    "verify": {"$ref": "#/$defs/stringList"},
    "warnings": {"$ref": "#/$defs/stringList"}
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
